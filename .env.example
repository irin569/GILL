# ==============================================================================
# GAME STORE - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Application URL
APP_URL="http://localhost:3000"

# Gemini API Key (Optional AI features)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# DATABASE & STORAGE CONFIGURATION (Production Options)
# ------------------------------------------------------------------------------
# Option A: Firebase Firestore & Authentication
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-app-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# Option B: PostgreSQL / Cloud SQL (Relational DB connection string)
DATABASE_URL="postgresql://db_user:db_password@localhost:5432/gamestore_db?sslmode=require"

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY INTEGRATIONS (Thailand & International)
# ------------------------------------------------------------------------------
# PromptPay Merchant Phone / Tax ID for QR Code payload generation
VITE_PROMPTPAY_ID="0812345678"

# Omise / Opn Payments (Credit Card & PromptPay Webhooks)
OMISE_PUBLIC_KEY="pkey_test_xxxxxx"
OMISE_SECRET_KEY="skey_test_xxxxxx"

# GB Prime Pay / 2C2P / Stripe (Alternative Gateways)
GBPRIME_PUBLIC_KEY="YOUR_GB_PUBLIC_KEY"
GBPRIME_SECRET_KEY="YOUR_GB_SECRET_KEY"
STRIPE_SECRET_KEY="sk_test_xxxxxx"

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
JWT_SECRET="super-secret-jwt-key-change-this-in-production"
ADMIN_SESSION_SECRET="admin-session-salt-xxxxxx"

